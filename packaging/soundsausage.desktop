[Desktop Entry]
Type=Application
Name=SoundSausage
GenericName=Audio Editor
GenericName[nl]=Audiobewerker
Comment=An intuitive audio editor with tools where you expect them
Comment[nl]=Een intuïtieve, eenvoudig te gebruiken audio-editor met alle tools op de plek waar je ze verwacht
Exec=soundsausage %f
Icon=soundsausage
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;
MimeType=audio/x-wav;audio/wav;
StartupNotify=true
StartupWMClass=SoundSausage
