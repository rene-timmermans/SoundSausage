pkgname=soundsausage
pkgver=0.6.0
pkgrel=1
pkgdesc='Waveform and multitrack audio editor'
arch=('x86_64')
url='https://github.com/rene-timmermans/SoundSausage'
license=('GPL-3.0-or-later')
depends=('python>=3.12' 'pyside6>=6.8' 'qt6-multimedia' 'python-numpy' 'libsamplerate')
makedepends=('gcc' 'make')
source=("soundsausage-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/soundsausage-${pkgver}"
    make
}

package() {
    cd "${srcdir}/soundsausage-${pkgver}"
    sh packaging/stage.sh "${pkgdir}"
}
